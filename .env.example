# This file (.env) is for LOCAL DEVELOPMENT only. The deployed-environment
# config (Neon, GCS, Cloud Run) lives in .env.deploy (gitignored) and is copied
# from there into GitHub secrets — see docs/deployment.md Phase 5.

# PostgreSQL (dev profile). The defaults below work with `docker compose up -d`.
# For a managed database (Neon, Cloud SQL) change host/credentials and set
# DB_SSLMODE=require.
DB_HOST=localhost
DB_PORT=5432
DB_NAME=booki
DB_USER=booki
DB_PASSWORD=booki
DB_SSLMODE=disable

# JWT
JWT_SECRET=change-me-in-production-this-is-a-dev-secret-32bytes

# File storage (uploaded PDFs and generated reports).
# local = disk under STORAGE_LOCAL_PATH ; s3 = any S3-compatible store.
STORAGE_DRIVER=local
STORAGE_LOCAL_PATH=./storage
# Only when STORAGE_DRIVER=s3. These values point at the docker-compose MinIO.
# For Cloudflare R2 / GCS: change endpoint, bucket and keys. See docs/deployment.md.
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=booki
S3_ACCESS_KEY=booki
S3_SECRET_KEY=bookibooki
S3_PATH_STYLE=true

# CORS: allowed origins, comma-separated. Add your LAN IP
# (e.g. http://192.168.x.x:5173) to test the app from a phone on the same WiFi.
CORS_ALLOWED_ORIGINS=http://localhost:5173

# AI provider: claude | openai | kimi | ollama
AI_PROVIDER=claude
ANTHROPIC_API_KEY=sk-ant-...
OPENAI_API_KEY=sk-...
KIMI_API_KEY=...
# Ollama: no API key, runs local to this backend (not on the user's device).
# llama3.2:1b by default because on hardware without a ROCm/CUDA-capable GPU an
# 8B model like llama3.1 is far too slow on pure CPU.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:1b
