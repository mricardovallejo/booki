# Base de datos (usado por backend en dev)
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DB=booki
MYSQL_USER=booki
MYSQL_PASSWORD=booki

# JWT
JWT_SECRET=change-me-in-production-this-is-a-dev-secret-32bytes

# Almacenamiento
PDF_STORAGE_PATH=./uploads

# CORS: orígenes permitidos, separados por coma. Agrega la IP de tu red local
# (ej. http://192.168.x.x:5173) para probar la app desde un celular en el mismo WiFi.
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Proveedor de IA: claude | openai | kimi | ollama
AI_PROVIDER=claude
ANTHROPIC_API_KEY=sk-ant-...
OPENAI_API_KEY=sk-...
KIMI_API_KEY=...
# Ollama: sin API key, corre local a este backend (no al dispositivo del usuario)
# llama3.2:1b por defecto porque en hardware sin GPU compatible con ROCm/CUDA
# un modelo de 8B como llama3.1 es demasiado lento en CPU pura.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:1b
