# Template for .env.deploy (gitignored) — the deployed-environment config.
#
# Fill every value, then push them to GitHub with:
#   scripts/push-deploy-secrets.sh
# (or add them by hand: repo Settings -> Secrets and variables -> Actions).
# Every key is a repository *secret* except GCP_REGION, a repository *variable*.
# The .github/workflows/deploy.yml workflow reads them. Full runbook:
# docs/deployment.md Phase 5.

# --- Database (Neon or any managed PostgreSQL) ---
# From the provider's connection string. Use the DIRECT host, not a
# transaction pooler — Flyway needs a real session. The workflow adds
# DB_SSLMODE=require itself.
DB_HOST=
DB_PORT=5432
DB_NAME=
DB_USER=
DB_PASSWORD=

# --- Google Cloud ---
GCP_PROJECT_ID=          # e.g. booki-123456 (the ID, not the display name)
GCP_REGION=us-east1      # repository VARIABLE, not a secret

# --- Object storage: GCS bucket + HMAC key ---
# Bucket: Cloud Storage -> Buckets -> Create (private, same region).
# Keys:   Cloud Storage -> Settings -> Interoperability -> create key for a
#         service account. Grant that SA "Storage Object Admin" on the bucket.
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=

# --- App ---
JWT_SECRET=              # openssl rand -base64 32
OPENAI_API_KEY=
CORS_ALLOWED_ORIGINS=    # https://<GCP_PROJECT_ID>.web.app

# --- GitHub -> GCP auth ---
# IAM -> Service Accounts -> create 'github-deployer' with roles: Cloud Run
# Admin, Cloud Build Editor, Service Account User, Storage Admin, Firebase
# Hosting Admin, Artifact Registry Writer. Add a JSON key; paste it whole,
# on ONE line.
GCP_SA_KEY=
