# Base de datos PostgreSQL (perfil dev). Con `docker compose up -d` estos
# valores por defecto ya funcionan. Para una base gestionada (Neon, Cloud SQL)
# cambia host/credenciales y pon DB_SSLMODE=require.
DB_HOST=localhost
DB_PORT=5432
DB_NAME=booki
DB_USER=booki
DB_PASSWORD=booki
DB_SSLMODE=disable

# JWT
JWT_SECRET=change-me-in-production-this-is-a-dev-secret-32bytes

# Almacenamiento de archivos (PDFs subidos y reportes generados).
# local = disco bajo STORAGE_LOCAL_PATH ; s3 = cualquier almacén S3-compatible.
STORAGE_DRIVER=local
STORAGE_LOCAL_PATH=./storage
# Solo si STORAGE_DRIVER=s3. Estos valores apuntan al MinIO de docker-compose.
# Para Cloudflare R2 / GCS: cambia endpoint, bucket y claves. Ver docs/deployment.md.
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=booki
S3_ACCESS_KEY=booki
S3_SECRET_KEY=bookibooki
S3_PATH_STYLE=true

# CORS: orígenes permitidos, separados por coma. Agrega la IP de tu red local
# (ej. http://192.168.x.x:5173) para probar la app desde un celular en el mismo WiFi.
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Proveedor de IA: claude | openai | kimi | ollama
AI_PROVIDER=claude
ANTHROPIC_API_KEY=sk-ant-...
OPENAI_API_KEY=sk-...
KIMI_API_KEY=...
# Ollama: sin API key, corre local a este backend (no al dispositivo del usuario)
# llama3.2:1b por defecto porque en hardware sin GPU compatible con ROCm/CUDA
# un modelo de 8B como llama3.1 es demasiado lento en CPU pura.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:1b
