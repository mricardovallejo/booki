# Copy to .env (gitignored) and fill in.

ANTHROPIC_API_KEY=            # the agent's own key (console.anthropic.com)
GCP_PROJECT_ID=               # e.g. booki-507302 (the ID, not the display name)
GCP_REGION=us-east1
CLOUD_RUN_SERVICE=booki-backend
FRONTEND_URL=https://booki-507302.web.app
# BACKEND_URL=                # optional; discovered from Cloud Run when blank
GITHUB_REPO=mricardovallejo/booki

# Printed by setup_service_account.sh. The agent acts as this limited account.
OPS_SERVICE_ACCOUNT=

# Path to your local clone, so the agent can read the runbook and ADRs.
BOOKI_REPO_PATH=..

# OPS_AGENT_MODEL=claude-sonnet-5-5
# OPS_AUDIT_LOG=audit.jsonl
